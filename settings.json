{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "permissions": {
    "allow": [
      "Bash",
      "WebFetch",
      "mcp__reverve-rag__semantic_search",
      "mcp__reverve-rag__get_document",
      "Read(//tmp/claude/c--work-reverve-RAG-DB/tasks/**)",
      "Read(//c/**)",
      "Edit(//**/*.xml)",
      "Write(//**/*.xml)",
      "Edit(//**/*.output)",
      "Write(//**/*.output)"
    ],
    "additionalDirectories": [
      "\\tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-rm.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/log-bash.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-secrets.sh",
            "statusMessage": "Checking for sensitive files..."
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-brainstorm.sh",
            "statusMessage": "Activating brainstorm phase..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-format.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/post-commit-simplify.sh"
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "latest",
  "enabledPlugins": {
    "telegram@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "hookify@claude-plugins-official": true
  },
  "effortLevel": "max"
}
