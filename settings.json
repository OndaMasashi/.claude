{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "1",
    "MCP_TIMEOUT": "120000",
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell",
      "Edit",
      "Write",
      "MultiEdit",
      "Read",
      "Grep",
      "Glob",
      "Monitor",
      "WebFetch",
      "WebSearch",
      "mcp__reverve-rag__semantic_search",
      "mcp__reverve-rag__get_document",
      "mcp__chrome-devtools__take_snapshot",
      "Bash(npx wrangler d1 execute:*)"
    ],
    "deny": [
      "Edit(c:/Users/Masashi.Onda/.claude/settings.json)",
      "Write(c:/Users/Masashi.Onda/.claude/settings.json)",
      "Edit(/c/Users/Masashi.Onda/.claude/settings.json)",
      "Write(/c/Users/Masashi.Onda/.claude/settings.json)",
      "Edit(c:/Users/Masashi.Onda/.claude/settings.local.json)",
      "Write(c:/Users/Masashi.Onda/.claude/settings.local.json)",
      "Edit(/c/Users/Masashi.Onda/.claude/settings.local.json)",
      "Write(/c/Users/Masashi.Onda/.claude/settings.local.json)",
      "Edit(c:/Users/Masashi.Onda/.claude/CLAUDE.md)",
      "Write(c:/Users/Masashi.Onda/.claude/CLAUDE.md)",
      "Edit(/c/Users/Masashi.Onda/.claude/CLAUDE.md)",
      "Write(/c/Users/Masashi.Onda/.claude/CLAUDE.md)",
      "mcp__vercel__buy_*",
      "mcp__vercel__buy_pro",
      "mcp__vercel__buy_credits",
      "mcp__vercel__buy_addon",
      "mcp__vercel__buy_domain",
      "mcp__vercel__deploy_to_vercel",
      "mcp__vercel__import-claude-design-from-url",
      "mcp__vercel__get_access_to_vercel_url",
      "mcp__vercel__change_toolbar_thread_resolve_status",
      "mcp__vercel__reply_to_toolbar_thread",
      "mcp__vercel__edit_toolbar_message",
      "mcp__vercel__add_toolbar_reaction"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "\\tmp",
      "C:\\Users\\Masashi.Onda\\AppData\\Local\\Temp",
      "C:\\Users\\MASASH~1.OND\\AppData\\Local\\Temp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-rm.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-direct-worktree-remove.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/log-bash.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-secrets.sh",
            "statusMessage": "Checking for sensitive files..."
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-ps-destructive.sh",
            "statusMessage": "Checking PowerShell command..."
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-brainstorm.sh",
            "statusMessage": "Activating brainstorm phase..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-format.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/post-commit-simplify.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/skill-usage-log.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/format-on-stop.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/ja-writing-guard.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "telegram@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "hookify@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoUpdatesChannel": "latest",
  "showThinkingSummaries": true,
  "agentPushNotifEnabled": true
}
